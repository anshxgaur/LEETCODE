from collections import Counter

class Solution(object):
    def reorderedPowerOf2(self, n):
        # digit count of input number
        count_n = Counter(str(n))
        
        # check all powers of 2 up to 10^9 (since n <= 10^9 usually)
        for i in range(31):  # 2^30 = 1073741824 (10 digits)
            if count_n == Counter(str(1 << i)):
                return True
        return False
